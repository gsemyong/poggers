{
  "name": "kit",
  "version": "0.0.0",
  "private": true,
  "description": "A portable TypeScript product language for programs, dependencies, and user interfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsemyong/poggers.git"
  },
  "bin": {
    "kit": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "config",
    "examples",
    "template",
    "template/.gitignore"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./dist/source/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./jsx-dev-runtime": {
      "source": "./dist/source/jsx/development.ts",
      "types": "./dist/src/jsx/development.d.ts",
      "default": "./dist/src/jsx/development.js"
    },
    "./jsx-runtime": {
      "source": "./dist/source/jsx/runtime.ts",
      "types": "./dist/src/jsx/runtime.d.ts",
      "default": "./dist/src/jsx/runtime.js"
    },
    "./web": {
      "source": "./dist/source/platforms/web/index.ts",
      "types": "./dist/src/platforms/web/index.d.ts",
      "default": "./dist/src/platforms/web/index.js"
    },
    "./adapters/web": {
      "source": "./dist/source/platforms/web/adapter/index.ts",
      "types": "./dist/src/platforms/web/adapter/index.d.ts",
      "default": "./dist/src/platforms/web/adapter/index.js"
    },
    "./server": {
      "source": "./dist/source/platforms/server/index.ts",
      "types": "./dist/src/platforms/server/index.d.ts",
      "default": "./dist/src/platforms/server/index.js"
    },
    "./testing": {
      "source": "./dist/source/testing/index.ts",
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./adapter": {
      "source": "./dist/source/adapter.ts",
      "types": "./dist/src/adapter.d.ts",
      "default": "./dist/src/adapter.js"
    },
    "./adapters/server": {
      "source": "./dist/source/platforms/server/adapter/index.ts",
      "types": "./dist/src/platforms/server/adapter/index.d.ts",
      "default": "./dist/src/platforms/server/adapter/index.js"
    },
    "./adapters/deployment/local": {
      "source": "./dist/source/deployment/adapters/local/index.ts",
      "types": "./dist/src/deployment/adapters/local/index.d.ts",
      "default": "./dist/src/deployment/adapters/local/index.js"
    },
    "./deployment/oci": {
      "source": "./dist/source/deployment/artifacts/oci/index.ts",
      "types": "./dist/src/deployment/artifacts/oci/index.d.ts",
      "default": "./dist/src/deployment/artifacts/oci/index.js"
    },
    "./deployment": {
      "source": "./dist/source/deployment/index.ts",
      "types": "./dist/src/deployment/index.d.ts",
      "default": "./dist/src/deployment/index.js"
    },
    "./factory": {
      "source": "./dist/source/factory.ts",
      "types": "./dist/src/factory.d.ts",
      "default": "./dist/src/factory.js"
    },
    "./features/actor": {
      "source": "./dist/source/features/actor/public.ts",
      "types": "./dist/src/features/actor/public.d.ts",
      "default": "./dist/src/features/actor/public.js"
    },
    "./features/data": {
      "source": "./dist/source/features/data/public.ts",
      "types": "./dist/src/features/data/public.d.ts",
      "default": "./dist/src/features/data/public.js"
    },
    "./features/aggregate": {
      "source": "./dist/source/features/aggregate/index.ts",
      "types": "./dist/src/features/aggregate/index.d.ts",
      "default": "./dist/src/features/aggregate/index.js"
    },
    "./features/projection": {
      "source": "./dist/source/features/projection/public.ts",
      "types": "./dist/src/features/projection/public.d.ts",
      "default": "./dist/src/features/projection/public.js"
    },
    "./features/replica": {
      "source": "./dist/source/features/replica/public.ts",
      "types": "./dist/src/features/replica/public.d.ts",
      "default": "./dist/src/features/replica/public.js"
    },
    "./features/identity": {
      "source": "./dist/source/features/identity/index.ts",
      "types": "./dist/src/features/identity/index.d.ts",
      "default": "./dist/src/features/identity/index.js"
    },
    "./features/model": {
      "source": "./dist/source/features/model/index.ts",
      "types": "./dist/src/features/model/index.d.ts",
      "default": "./dist/src/features/model/index.js"
    },
    "./features/workflow": {
      "source": "./dist/source/features/workflow/public.ts",
      "types": "./dist/src/features/workflow/public.d.ts",
      "default": "./dist/src/features/workflow/public.js"
    },
    "./tsconfig": "./config/tsconfig.json"
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "check:distribution": "tsc -p src/platforms/web/adapter/fixtures/request-render/tsconfig.json && vitest run --tagsFilter='package && !production' src/realization.spec.ts src/platforms/web/adapter/pipeline.spec.ts src/platforms/web/adapter/fixtures/request-render/src/system.spec.ts",
    "check:examples": "nub run typecheck:examples && vitest run --tagsFilter='!production' examples && vitest run --tagsFilter=package src/cli.spec.ts",
    "check:compiler": "vitest run --no-file-parallelism --tagsFilter='compiler && !package' src/compiler src/features/actor/feature.spec.ts src/realization.spec.ts src/platforms/server/adapter/rust",
    "check:providers": "vitest run --tagsFilter=provider src/features src/platforms/server && cargo test --workspace",
    "check:presentation": "vitest run src/platforms/web/presentation src/platforms/web/adapter/presentation src/platforms/web/adapter/ui/component/adapter.spec.ts",
    "check:production": "KIT_NATIVE_PROFILE=release vitest run --no-file-parallelism --tagsFilter=production src examples",
    "check:source": "nub run typecheck && nub run lint && nub run fmt:check && nub run test",
    "check:workflow": "nub run check:workflow:source && nub run check:workflow:compiler",
    "check:workflow:compiler": "vitest run --no-file-parallelism --tagsFilter='compiler && !native && !package && !provider && !production' src/features/workflow/feature.spec.ts src/features/workflow/ir.spec.ts",
    "check:workflow:source": "vitest run --no-file-parallelism --tagsFilter='!compiler && !native && !package && !provider && !production' src/features/workflow/feature.spec.ts",
    "dev": "nub src/cli.ts dev --dir examples/basic",
    "fmt": "oxfmt --config config/format.json .",
    "fmt:check": "oxfmt --config config/format.json --check .",
    "lint": "oxlint --config config/lint.json --disable-nested-config src scripts config template examples vitest.config.ts",
    "release": "nub scripts/release.ts",
    "release:check": "nub scripts/release.ts --check",
    "test": "vitest run --no-file-parallelism --tagsFilter='!compiler && !package && !provider && !production' --exclude='examples/**' --exclude='src/features/workflow/**'",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -b --pretty false examples/basic examples/authenticated-crud examples/presentation",
    "check": "nub run check:source && nub run check:workflow && nub run check:compiler && nub run check:providers && nub run build && nub run check:examples && nub run check:distribution && nub run check:production"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@tanstack/virtual-core": "^3.17.6",
    "@tursodatabase/database-wasm": "0.7.2",
    "@types/node": "^26.1.1",
    "@typescript/typescript6": "^6.0.2",
    "alien-signals": "^3.2.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.4.13",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
