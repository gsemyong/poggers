{
  "name": "kit",
  "version": "0.0.0",
  "private": true,
  "description": "A portable TypeScript product language for programs, dependencies, and user interfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsemyong/poggers.git"
  },
  "bin": {
    "kit": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs/actors.md",
    "docs/compatibility.md",
    "docs/data.md",
    "docs/features.md",
    "docs/migrations",
    "docs/workflows.md",
    "examples/basic",
    "examples/basic/.gitignore",
    "tsconfig.json"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./dist/source/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ui": {
      "source": "./dist/source/ui.ts",
      "types": "./dist/src/ui.d.ts",
      "default": "./dist/src/ui.js"
    },
    "./jsx-dev-runtime": {
      "source": "./dist/source/jsx/development.ts",
      "types": "./dist/src/jsx/development.d.ts",
      "default": "./dist/src/jsx/development.js"
    },
    "./jsx-runtime": {
      "source": "./dist/source/jsx/runtime.ts",
      "types": "./dist/src/jsx/runtime.d.ts",
      "default": "./dist/src/jsx/runtime.js"
    },
    "./web": {
      "source": "./dist/source/platforms/web/platform.ts",
      "types": "./dist/src/platforms/web/platform.d.ts",
      "default": "./dist/src/platforms/web/platform.js"
    },
    "./adapters/web": {
      "source": "./dist/source/adapters/web/adapter.ts",
      "types": "./dist/src/adapters/web/adapter.d.ts",
      "default": "./dist/src/adapters/web/adapter.js"
    },
    "./server": {
      "source": "./dist/source/platforms/server/platform.ts",
      "types": "./dist/src/platforms/server/platform.d.ts",
      "default": "./dist/src/platforms/server/platform.js"
    },
    "./testing": {
      "source": "./dist/source/testing.ts",
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    },
    "./adapter": {
      "source": "./dist/source/contracts/platform.ts",
      "types": "./dist/src/contracts/platform.d.ts",
      "default": "./dist/src/contracts/platform.js"
    },
    "./adapters/server": {
      "source": "./dist/source/adapters/server/adapter.ts",
      "types": "./dist/src/adapters/server/adapter.d.ts",
      "default": "./dist/src/adapters/server/adapter.js"
    },
    "./cli": {
      "source": "./dist/source/cli.ts",
      "types": "./dist/src/cli.d.ts",
      "default": "./dist/src/cli.js"
    },
    "./tsconfig": "./tsconfig.json"
  },
  "scripts": {
    "api:check": "nub scripts/api.ts",
    "api:update": "nub run build && nub scripts/api.ts --write",
    "actor:benchmark": "nub scripts/actor.ts",
    "build": "nub scripts/build.ts",
    "check:distribution": "tsc -p src/adapters/web/fixtures/request-render/tsconfig.json",
    "check:examples": "tsc -p examples/basic/tsconfig.json && tsc -p examples/authenticated-crud/tsconfig.json && tsc -p playground/tsconfig.json",
    "check:native": "vitest run --tagsFilter=native && cargo test --manifest-path src/adapters/server/production/Cargo.toml --workspace",
    "check:presentation": "nub run presentation:check && vitest run src/core/ui/presentation.spec.ts src/compiler/presentation.spec.ts src/platforms/web/presentation.spec.ts src/platforms/web/presentation/dynamics.spec.ts src/adapters/web/ui/presentation",
    "check:production": "vitest run --tagsFilter=production && KIT_NATIVE_PROFILE=release vitest run src/features/data.spec.ts -t \"builds the composed data Feature as a native executable\"",
    "check:workflow": "vitest run src/features/workflow.spec.ts && cargo test --manifest-path src/adapters/server/production/Cargo.toml -p kit-server-workflow",
    "dev:crud": "nub src/cli.ts dev --dir examples/authenticated-crud",
    "dev:example": "nub src/cli.ts dev --dir playground",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --disable-nested-config src scripts examples playground vitest.config.ts",
    "presentation:check": "nub scripts/presentation.ts",
    "presentation:update": "nub scripts/presentation.ts --write",
    "release": "nub scripts/release.ts",
    "release:check": "nub scripts/release.ts --check",
    "test": "vitest run --tagsFilter='!native && !production'",
    "test:workflow": "vitest run src/features/workflow.spec.ts --tagsFilter='!native && !production'",
    "typecheck": "tsc --noEmit",
    "check": "nub run typecheck && nub run lint && nub run fmt:check && vitest run && cargo test --manifest-path src/adapters/server/production/Cargo.toml --workspace && nub run build && nub run check:examples && nub run api:check && nub run presentation:check && nub run check:distribution && KIT_NATIVE_PROFILE=release vitest run src/features/data.spec.ts -t \"builds the composed data Feature as a native executable\""
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@tanstack/virtual-core": "^3.17.6",
    "@tursodatabase/database": "0.7.1",
    "@tursodatabase/database-wasm": "0.7.1",
    "@typescript/typescript6": "^6.0.2",
    "alien-signals": "^3.2.1",
    "better-auth": "^1.6.24",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.0.7",
    "@types/node": "^26.1.1",
    "@webref/css": "8.7.0",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "web-features": "3.34.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "nub@0.4.13"
}
